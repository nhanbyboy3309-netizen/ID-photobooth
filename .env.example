# Gemini API Key (Secret) — set qua AI Studio Secrets, đọc lúc runtime nên hoạt động bình thường
GEMINI_API_KEY=

# Lưu ý: gate key (khớp với EXECUTION_API_KEY trong photo-moments/src/pages/Cart.tsx)
# được hardcode trực tiếp trong services/photoMomentsBridge.ts, không đọc từ env —
# AI Studio Secrets không bơm biến VITE_* vào bước build của Vite, nên đặt ở đây sẽ
# luôn ra rỗng trên bản deploy thật.
